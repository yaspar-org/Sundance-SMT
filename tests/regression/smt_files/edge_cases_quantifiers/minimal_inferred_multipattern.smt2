; Greedy selection initially chooses pa, pb, and pc, but pb+pc already cover
; every variable. The redundant pa term has no ground match and must be pruned.
(set-logic ALL)
(declare-sort U 0)
(declare-const A U)
(declare-const B U)
(declare-const C U)
(declare-const D U)
(declare-const E U)
(declare-const F U)
(declare-fun pa (U U U U) Bool)
(declare-fun pb (U U U) Bool)
(declare-fun pc (U U U) Bool)
(assert (forall ((a U) (b U) (c U) (d U) (e U) (f U))
  (=> (and (pb a b e) (pc c d f))
      (or (= a f) (and false (pa a b c d))))))
(assert (pb A B E))
(assert (pc C D F))
(assert (distinct A F))
(check-sat)
