(set-logic ALL)
(declare-sort U 0)
(declare-fun p (U) Bool)
(declare-fun r (U) Bool)
(declare-const a U)
(declare-const b U)
(declare-const c U)

(assert (p a))
(assert (p b))
(assert (p c))
(assert (r a))
(assert (r b))
(assert (not (r c)))
(assert (forall ((x U)) (! (=> (p x) (r x)) :pattern ((p x)))))

(check-sat)
