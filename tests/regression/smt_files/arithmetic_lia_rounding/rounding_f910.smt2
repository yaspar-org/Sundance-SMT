(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (or (= (+ 1 (* (- 3) x2) (* 3 x1)) (+ 4 (* (- 2) x2) (* 2 (div x2 2)))) (< (+ (- 5) (* (- 3) x1) (* 2 (div x0 (- 2)))) (+ 4 (* 1 x2) (* (- 2) x1)))))
(assert (or (<= (+ (- 2) (* 3 x1)) (+ 3 (* (- 3) x0) (* (- 1) x0))) (= (+ (- 3) (* (- 3) x0) (* (- 1) x2)) 3)))
(assert (= (+ (- 1) (* 3 x0)) (+ (- 3) (* (- 3) x0))))
(assert (or (= (+ (- 1) (* (- 2) x1) (* 1 (mod x0 3))) (+ (- 4) (* (- 3) x1))) (< (+ (- 3) (* 3 x1) (* (- 3) x2)) (+ 3 (* 3 x2) (* (- 2) x0)))))
(assert (or (= (+ 2 (* 2 x1)) (+ 4 (* (- 3) x2))) (<= (+ 6 (* 1 x0) (* (- 1) x1)) (+ (- 2) (* 2 x1) (* (- 3) x1)))))
(assert (or (<= (- 1) (+ 0 (* 1 x2))) (<= (+ 4 (* (- 1) x0)) (+ 0 (* (- 1) x0) (* 1 x2)))))
(check-sat)
