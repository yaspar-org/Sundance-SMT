(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (or (< (+ (- 4) (* 1 x2) (* 3 x0)) (+ 0 (* (- 3) x1))) (= (+ (- 6) (* (- 1) x2)) 5)))
(assert (or (< (+ (- 3) (* (- 2) x1) (* 1 x0) (* 2 (mod x2 2))) (- 1)) (<= (+ 2 (* (- 1) x0) (* 1 x2)) (- 2))))
(assert (< (+ (- 2) (* (- 3) x1) (* 1 x2)) (+ (- 4) (* 1 (div x0 3)))))
(assert (or (< (+ 2 (* 1 x0) (* (- 3) x1)) (+ (- 6) (* 3 x1) (* (- 2) x1))) (<= (+ (- 5) (* (- 1) x0)) (+ 1 (* (- 3) x0)))))
(assert (not (<= (+ 1 (* (- 2) x0) (* 1 x0) (* 2 (mod x0 3))) (+ 6 (* 1 (div x1 3))))))
(check-sat)
