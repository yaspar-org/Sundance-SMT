(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (= (+ 3 (* 3 x2)) (+ 4 (* 3 x0))))
(assert (<= (+ (- 5) (* 1 (mod x0 2))) (+ 0 (* (- 2) x0) (* 1 (mod x0 2)))))
(assert (<= (+ 5 (* (- 3) x1)) (+ 6 (* (- 2) x1) (* 1 (mod x1 3)))))
(assert (or (< (+ 2 (* (- 2) x1) (* (- 1) x0)) (+ (- 4) (* (- 3) x2))) (<= 4 (+ (- 2) (* (- 2) x0) (* (- 1) x1) (* 2 (mod x0 (- 2)))))))
(check-sat)
