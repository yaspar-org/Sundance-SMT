(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (or (<= (+ 2 (* 3 x0) (* 1 x0)) (+ 2 (* 1 x1) (* 1 x2))) (< (+ 3 (* (- 2) x2) (* (- 1) x1)) (+ (- 3) (* (- 1) x0)))))
(assert (<= (+ (- 5) (* 3 x0) (* (- 3) x1)) (+ (- 1) (* (- 1) x0))))
(assert (or (< (+ 6 (* 2 x0) (* (- 2) x0)) (+ 1 (* (- 3) x1))) (<= (+ 0 (* 2 (div x2 2))) (+ (- 3) (* 3 x0) (* (- 3) x0) (* 2 (mod x1 2))))))
(assert (= (+ 1 (* 2 x2)) (+ (- 6) (* 3 x1) (* 2 x1))))
(assert (not (<= (+ 3 (* (- 1) x2) (* 3 x2)) (+ (- 6) (* 3 x1) (* (- 1) x0) (* 2 (mod x2 3))))))
(check-sat)
