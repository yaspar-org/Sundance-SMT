(assert (or (<= (+ (- 4) (* 2 (div x2 (- 2)))) (+ (- 4) (* (- 2) x1) (* (- 2) x1) (* 1 (div x2 (- 2))))) (< (+ (- 6) (* 3 x2) (* 2 (mod x2 2))) 4)))
(assert (= (+ (- 4) (* (- 2) x1) (* 3 x0) (* 1 (div x0 (- 2)))) (+ 1 (* (- 1) x0) (* 1 x2))))
(check-sat)
