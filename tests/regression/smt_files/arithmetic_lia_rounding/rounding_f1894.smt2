(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (<= (+ 0 (* 1 (mod x0 3))) (+ (- 6) (* (- 2) x1) (* 2 x2) (* 2 (div x2 3)))))
