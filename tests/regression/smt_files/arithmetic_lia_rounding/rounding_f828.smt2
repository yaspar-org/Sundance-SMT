(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (<= (+ 5 (* 2 (mod x2 2))) (+ 0 (* (- 2) x1) (* 1 (div x0 3)))))
(assert (or (= (+ 0 (* (- 3) x0)) (+ 0 (* 3 x1) (* 2 (mod x1 2)))) (<= (+ (- 4) (* 1 x0) (* (- 1) x2)) (+ (- 1) (* 2 x1) (* (- 2) x1)))))
(assert (not (or (<= (+ (- 5) (* (- 3) x2) (* 1 x1)) (+ (- 6) (* (- 3) x1))) (< 0 (- 5)))))
(check-sat)
