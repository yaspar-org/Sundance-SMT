(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (= (+ 6 (* (- 2) x0) (* (- 1) x2) (* 1 (div x2 (- 2)))) (+ (- 5) (* 2 (div x2 3)))))
(assert (or (< (- 6) (+ 2 (* (- 3) x2))) (<= 2 (- 5))))
(check-sat)
