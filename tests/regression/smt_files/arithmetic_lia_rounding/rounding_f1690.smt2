(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (not (or (= (+ 1 (* 2 x0) (* 1 x2)) (+ 6 (* 1 x0) (* (- 2) x0))) (<= (+ (- 3) (* 2 (mod x1 3))) (+ 2 (* (- 1) x0) (* 3 x2))))))
(assert (= (+ 6 (* 3 x2)) (+ (- 4) (* 3 x2) (* (- 3) x0) (* 2 (mod x0 2)))))
(check-sat)
