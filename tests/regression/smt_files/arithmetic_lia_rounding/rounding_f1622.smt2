(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (< (+ (- 1) (* (- 2) x1) (* (- 2) x2) (* 1 (mod x2 2))) (+ 3 (* 2 x2) (* (- 3) x2) (* 2 (div x1 2)))))
(assert (not (= (+ 6 (* 3 x0)) (- 1))))
(assert (<= (+ (- 5) (* (- 2) x2) (* (- 2) x0)) (- 6)))
(assert (< 4 (+ 5 (* 1 x0) (* (- 1) x2))))
(assert (or (<= 4 (+ (- 4) (* (- 1) x1) (* 2 x0))) (< 2 (+ (- 3) (* (- 1) x2) (* 2 (mod x0 3))))))
(check-sat)
