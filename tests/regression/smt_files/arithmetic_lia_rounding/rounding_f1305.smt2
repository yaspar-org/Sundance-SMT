(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (< (+ 0 (* 1 x1)) (+ 0 (* (- 3) x0) (* 2 (div x0 2)))))
(assert (< (+ 5 (* (- 1) x1) (* 1 (mod x1 (- 2)))) (+ 4 (* (- 2) x2) (* 2 x1))))
(assert (= (+ 0 (* 3 x0) (* (- 2) x1)) (+ (- 5) (* (- 2) x1))))
(check-sat)
