(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (or (<= (+ 4 (* (- 3) x0) (* 3 x1) (* 2 (div x1 (- 2)))) (+ (- 2) (* 2 x1))) (<= (+ 3 (* 1 x2) (* 3 x1)) (+ 1 (* (- 2) x1) (* 1 (div x1 3))))))
(assert (or (< 3 (+ 1 (* 3 x1) (* (- 3) x2) (* 1 (mod x1 (- 2))))) (= (+ (- 3) (* 2 x2) (* 2 x1)) (- 6))))
(assert (< (+ 6 (* (- 3) x1) (* 1 (mod x2 (- 2)))) (+ (- 5) (* 3 x2) (* 1 x2))))
(assert (<= 1 (+ (- 6) (* 3 x0) (* 2 x1))))
(assert (< (+ (- 5) (* 1 (div x0 3))) (+ 1 (* (- 2) x1))))
(check-sat)
