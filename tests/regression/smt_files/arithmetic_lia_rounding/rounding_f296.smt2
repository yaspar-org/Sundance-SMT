(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (or (< (+ (- 1) (* 3 x0) (* 3 x2)) (- 4)) (<= 5 (+ (- 6) (* 3 x2)))))
(assert (= (+ (- 3) (* (- 3) x0) (* (- 2) x2)) (+ 0 (* 3 x2))))
(check-sat)
