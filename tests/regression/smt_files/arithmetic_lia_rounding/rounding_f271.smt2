(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (not (or (= (+ (- 1) (* 3 x0)) (+ 2 (* 1 x0) (* (- 3) x2))) (< (+ 4 (* (- 3) x1) (* 1 x0)) (+ (- 4) (* 3 x1) (* (- 3) x1) (* 2 (div x2 2)))))))
(assert (or (= (- 4) 1) (< (+ 6 (* 3 x0)) 3)))
(assert (not (<= (+ 0 (* 2 x2)) (- 5))))
(assert (or (< 1 0) (<= (+ 5 (* 2 x2) (* (- 1) x1)) (- 2))))
(assert (or (< (+ 2 (* 1 x1) (* 3 x0)) (+ 3 (* (- 3) x2) (* (- 1) x0) (* 1 (div x2 (- 2))))) (= (+ 5 (* (- 1) x1) (* 2 (mod x1 3))) 2)))
(check-sat)
