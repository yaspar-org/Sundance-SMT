(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (< (+ (- 3) (* 2 x1) (* 1 (mod x1 (- 2)))) (+ 2 (* 1 (div x1 (- 2))))))
(assert (or (= (+ 3 (* 2 x1) (* 3 x0)) (- 3)) (< (+ 2 (* 3 x0) (* (- 1) x2)) (+ 6 (* (- 1) x0) (* (- 1) x2)))))
(assert (= (+ 2 (* 1 (mod x0 (- 2)))) (+ 5 (* 3 x0) (* 2 x2) (* 2 (mod x2 (- 2))))))
(assert (< 6 (+ 6 (* 1 x1))))
(check-sat)
