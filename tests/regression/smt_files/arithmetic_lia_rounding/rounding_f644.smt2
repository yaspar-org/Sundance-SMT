(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(assert (<= (- 3) x0))
(assert (<= x0 3))
(assert (<= (- 3) x1))
(assert (<= x1 3))
(assert (<= (- 3) x2))
(assert (<= x2 3))
(assert (< 0 (+ 3 (* 2 x0) (* (- 2) x0))))
(assert (not (= (+ 5 (* (- 1) x2) (* 2 (div x0 3))) 3)))
(assert (< (+ (- 4) (* 2 x0) (* (- 2) x2)) (+ (- 6) (* (- 3) x2) (* 1 (mod x0 2)))))
(assert (= (- 2) (+ (- 4) (* (- 3) x0))))
(assert (or (<= (+ (- 3) (* 2 x1) (* 3 x2)) (+ 4 (* 2 x0) (* 1 x2))) (<= (+ 0 (* 2 (div x0 (- 2)))) (+ 6 (* (- 2) x0)))))
(check-sat)
