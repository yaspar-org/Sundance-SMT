; Mutually recursive cycle: t = node(f) and f = cons(t, empty)
(set-logic ALL)
(declare-datatypes ((Tree 0) (Forest 0))
  (((leaf) (node (children Forest)))
   ((empty) (cons (car Tree) (cdr Forest)))))
(declare-const t Tree)
(declare-const f Forest)
(assert (= t (node f)))
(assert (= f (cons t empty)))
(check-sat)
