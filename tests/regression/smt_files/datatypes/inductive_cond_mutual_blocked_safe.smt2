(set-logic ALL)
(declare-datatypes ((A 0) (B 0) (D 0))
  (((ctorA_rec (selAr B)) (ctorA_safe (selAs D)))
   ((ctorB_rec (selBr A)) (ctorB_safe (selBs D)))
   ((ctorD_val (selD Int)))))
(declare-const x A)
(declare-const y A)
; Both x and y forced recursive, their B-children recursive, grandchild = the other
(assert ((_ is ctorA_rec) x))
(assert ((_ is ctorA_rec) y))
(assert (not ((_ is ctorB_safe) (selAr x))))
(assert (not ((_ is ctorB_safe) (selAr y))))
(assert (= (selBr (selAr x)) y))
(assert (= (selBr (selAr y)) x))
(check-sat)
