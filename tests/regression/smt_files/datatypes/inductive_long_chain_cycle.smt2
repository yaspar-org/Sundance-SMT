; Longer cycle: x = Cons(1, y), y = Cons(2, z), z = Cons(3, x)
(set-logic ALL)
(declare-datatypes ((List 1)) ((par (T) ((Nil) (Cons (head T) (tail (List T)))))))
(declare-const x (List Int))
(declare-const y (List Int))
(declare-const z (List Int))
(assert (= x (Cons 1 y)))
(assert (= y (Cons 2 z)))
(assert (= z (Cons 3 x)))
(check-sat)
