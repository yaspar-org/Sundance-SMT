(set-logic QF_UF)
(declare-sort U 0)
(declare-fun a () U)
(declare-fun b () U)
(declare-fun c () U)
(declare-fun f (U) U)
(assert (= a b))
(check-sat)
(push 1)
(assert (not (= (f a) (f b))))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (= b c))
(assert (not (= (f a) (f c))))
(check-sat)
(pop 1)
(assert (not (= a c)))
(check-sat)
(check-sat-assuming ((= b c)))
(check-sat)
(assert (= c b))
(check-sat)
