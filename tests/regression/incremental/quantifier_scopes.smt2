(set-logic ALL)
(declare-sort U 0)
(declare-fun P (U) Bool)
(declare-fun Q (U) Bool)
(declare-fun a () U)
(declare-fun b () U)
(push 1)
(assert (forall ((x U)) (! (P x) :pattern ((P x)))))
(assert (not (P a)))
(check-sat)
(pop 1)
(assert (not (P a)))
(check-sat)
(push 1)
(assert (forall ((x U)) (! (P x) :pattern ((P x)))))
(check-sat)
(pop 1)
(check-sat)
(assert (forall ((x U)) (! (=> (Q x) (P x)) :pattern ((Q x)))))
(check-sat)
(push 1)
(assert (Q a))
(check-sat)
(pop 1)
(push 1)
(assert (Q b))
(assert (not (P b)))
(check-sat)
(pop 1)
(check-sat-assuming ((Q a)))
(check-sat)
